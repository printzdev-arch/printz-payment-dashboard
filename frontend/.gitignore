# ===================================================
# Dependencies & Package Managers
# ===================================================
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ===================================================
# Build & Distribution Outputs
# ===================================================
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# Vite temporary config dumps
vite.config.js.timestamp-*.mjs
vite.config.ts.timestamp-*.mjs

# ===================================================
# Local & Environment Variables
# ===================================================
*.local
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Preserve template and example configs
!.env.example
!.env.template
!.env.sample
!.env.defaults

# ===================================================
# Logs & Process Diagnostics
# ===================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ===================================================
# Testing & Coverage
# ===================================================
coverage/
.nyc_output/
test-results/
test-reports/
playwright-report/
blob-report/
cypress/videos/
cypress/screenshots/
*.lcov

# ===================================================
# Uploads, Caches & Temporary Files
# ===================================================
# Ignore all uploaded files but preserve folder via .gitkeep
uploads/*
!uploads/.gitkeep
temp_uploads/
.eslintcache
.stylelintcache
.cache/
tmp/
temp/

# ===================================================
# Compressed Archives & Backups
# ===================================================
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
backups/
backup/

# ===================================================
# Editor & IDE Directories
# ===================================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~
*.sublime-project
*.sublime-workspace

# ===================================================
# Operating System Files
# ===================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ===================================================
# Local Tooling, Scratch & Merge Leftovers
# ===================================================
.claude/
.playwright-mcp/
scratch/
scratchpad/
*.tmp
*.bak
*.orig
*.rej

# ===================================================
# Always Preserve .gitkeep Files
# ===================================================
!.gitkeep
