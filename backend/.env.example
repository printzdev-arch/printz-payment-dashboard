# Backend Environment Configuration Template
# Copy this file to .env, .env.staging, or .env.production and configure appropriate values.

# Server Port and Environment
PORT=5000
NODE_ENV=staging # development | staging | production | test

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/printzpayment_staging

# JSON Web Token Configuration
JWT_SECRET=change_this_to_a_secure_random_string_in_staging_or_prod
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_this_to_another_secure_random_string
REFRESH_TOKEN_EXPIRES_IN=30d

# Allowed CORS Origins (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:3000
CORS_ORIGIN=*

# Uploads & Media Storage Directory
UPLOAD_DIR=uploads
