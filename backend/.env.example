# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB connection (use either name; MONGODB_URI wins)
# Local:  mongodb://127.0.0.1:27017/printz_db
# Atlas:  mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_CLUSTER>/<DATABASE_NAME>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/printz_db

# JSON Web Token configuration (production needs real secrets of at least 32 characters)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-of-32-or-more-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Allowed browser origins, comma separated (CLIENT_URL is the older name for the same setting)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Uploads & media storage directory
UPLOAD_DIR=uploads

# Optional: password-reset / day-end report e-mail. Without these, mail is only logged, not delivered.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Printz Portal" <no-reply@example.com>

# Optional: WhatsApp receipts and notifications
# WHATSAPP_API_URL=
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
