# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
# Format: mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_CLUSTER>/<DATABASE_NAME>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_CLUSTER>/<DATABASE_NAME>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<DB_USER>:<URL_ENCODED_PASSWORD>@<ATLAS_CLUSTER>/<DATABASE_NAME>?retryWrites=true&w=majority

# JSON Web Token Configuration
JWT_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=30d

# Allowed CORS Origins
CLIENT_URL=http://localhost:3000,http://localhost:5173
CORS_ORIGIN=*

# Uploads & Media Storage Directory
UPLOAD_DIR=uploads
