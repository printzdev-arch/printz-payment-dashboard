{
  "name": "printz-backend",
  "version": "1.0.0",
  "description": "Printz Payment Dashboard Backend with Express.js, MongoDB, JWT and RBAC",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node scripts/test-pos-rbac-connection.js && node scripts/test-api-http.js",
    "docs:verify": "node scripts/verifySwagger.js",
    "init-db": "node scripts/initDatabase.js",
    "seed:designers": "node scripts/seedDesigners.js",
    "seed:all": "node scripts/seedAllCollections.js",
    "seed:rbac": "node scripts/seed-rbac.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "rbac",
    "dashboard"
  ],
  "author": "Printz Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "nodemonConfig": {
    "watch": ["src", ".env"],
    "ext": "js,json,env",
    "ignore": ["uploads/*", "node_modules/*", "tests/*", "*.log"]
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.4"
  }
}
